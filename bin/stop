#!/bin/sh

PID_FILE="var/mlpd.pid"
if [ ! -f "$PID_FILE" ]; then
  echo "Error: PID file not found at $PID_FILE"
  exit 1
fi

DAEMON_PID=$(cat "$PID_FILE")
if ! ps -p "$DAEMON_PID" > /dev/null 2>&1; then
  echo "Process with PID $DAEMON_PID is not running. Cleaning up stale PID file."
  rm -f "$PID_FILE"
  exit 0
fi

echo "Stopping Java daemon (PID: $DAEMON_PID)..."
kill "$DAEMON_PID"

TIMEOUT=10
while [ $TIMEOUT -gt 0 ]; do
  if ! ps -p "$DAEMON_PID" > /dev/null 2>&1; then
    rm -f "$PID_FILE"
    echo "Java daemon stopped successfully."
    exit 0
  fi
  sleep 1
  TIMEOUT=$((TIMEOUT - 1))
done

echo "Daemon did not stop in time. Forcing termination (SIGKILL)..."
kill -9 "$DAEMON_PID"
rm -f "$PID_FILE"
